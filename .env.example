# FarmFlow AI — Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# SMS Provider for OTP delivery
# Options: console (default, logs to terminal), twilio, msg91, aws_sns
SMS_PROVIDER=console

# SMS API credentials (provider-specific)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=FarmFlow

# OTP Configuration
OTP_EXPIRY_SECONDS=300
